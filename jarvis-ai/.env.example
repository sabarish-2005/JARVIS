# ==================== JARVIS ENVIRONMENT VARIABLES ====================
# Copy this file to .env and fill in your API keys

# Groq API Key (for AI chat)
# Get it from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (alternative AI provider, optional)
# Get it from: https://platform.openai.com
# OPENAI_API_KEY=your_openai_api_key_here

# ==================== API SERVER CONFIGURATION ====================

# API Server Settings
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=True

# Flask Settings
FLASK_ENV=development
FLASK_APP=api_server.py

# CORS Settings (React Frontend URL)
REACT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ==================== VOICE SETTINGS ====================

# Default Voice for TTS
TTS_ENGINE=pyttsx3
TTS_VOICE_RATE=150

# Speech Recognition Language
SR_LANGUAGE=en-US

# Wake Word
WAKE_WORD=jarvis

# ==================== DATABASE (Optional) ====================

# DATABASE_URL=sqlite:///jarvis.db

# ==================== LOGGING ====================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log

# ==================== SECURITY (Production) ====================

# Secret Key for Sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=your_secret_key_here

# API Rate Limiting
RATE_LIMIT=100/hour

# HTTPS/SSL (optional)
# SSL_CERT=/path/to/cert.pem
# SSL_KEY=/path/to/key.pem
